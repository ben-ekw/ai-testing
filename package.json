{
  "name": "aiwebsite",
  "private": true,
  "license": "Unlicense",
  "description": "Static single-page site; this file only drives linting.",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"theme/**/*.css\"",
    "lint:js": "eslint js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
